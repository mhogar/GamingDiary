<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" type="text/css" href="../../style.css">
    {{range .Stylesheets}}
    <link rel="stylesheet" type="text/css" href="../{{.}}">
    {{end}}
</head>
<body class="{{.Theme}}" style="background-image: url('../{{.Background}}');">
  <div class="page-container">
    <h1 class="series-title series-color list-toggle">{{.Title}}</h1>
    <h3 class="dates">{{len .Entries}} Videos [{{.TotalDuration}}] {{if .Dates}}| {{.Dates}}{{end}}</h3>
    {{if .YoutubePlaylist}}<a href="{{.YoutubePlaylist}}" target="_blank">Youtube Playlist</a>{{end}}
    <hr class="divider" />
    <a id="scroll-to-bottom" class="scroll-button">Bottom</a>
    <ul>
      {{range .Entries}}
      <li>
        <h2 class="list-toggle entry-title {{.Group}}">{{.Title}}</h2>
        <div class="collapsable entry">
          <div class="grid-container">
            <img src="{{if .Local}}{{.Thumbnail}}{{else}}{{.YoutubeThumbnail}}{{end}}" width="100%" onerror="this.onerror=null; this.src='{{.DefaultThumbnail}}';" />
            <div class="entry-body">
              <p class="card-header">
                {{if .Local}}
                {{if .Video}}<a href="{{.Video}}" target="_blank">Play Video</a>{{else}}<a class="disabled">No Video</a>{{end}}
                {{else}}
                {{if .YoutubeVideo}}<a href="{{.YoutubeVideo}}" target="_blank">Play on Youtube</a>{{else}}<a class="disabled">No Video</a>{{end}}
                {{end}}
              </p>
              <p>[{{.Duration}}] | {{.Date}}</p>
              <hr />
              {{if .Local}}<p class="youtube-link"><a href="{{.YoutubeVideo}}" target="_blank">{{.YoutubeVideo}}</a></p>{{end}}
              <p>{{.Description}}</p>
            </div>
          </div>
        </div>
      </li>
      {{end}}
    </ul>
    <a id="scroll-to-top" class="scroll-button">Top</a>
  </div>
  <script src="../../script.js"></script>
</body>
</html>
