<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" type="text/css" href="style.css">
    <link rel="icon" type="image/png" href="logo_v2.png">
</head>
<body>
  <div class="page-container">
    <h1 class="root-title rainbow-text">
        <span>Just</span>
        <span>Some</span>
        <span>Gaming</span>
        <span>Diary</span>
    </h1>
    <h2 class="video-stats root-header">{{.VideoCount}} Videos ({{.TotalDuration}})</h2>
    <h3 class="dates root-header">{{.Dates}}</h3>
    <hr class="divider" />
    <ul>
        {{range .Series}}
        <li class="{{.Theme}}">
            <h1 class="entry-title list-toggle">Series {{.Index | printf "%02d"}} | {{.Title}}</h1>
            <div class="entry collapsable">
                <div class="grid-container">
                    <img src="{{.Thumbnail}}" width="100%"/>
                    <div class="entry-body">
                    <p class="card-header">{{range .SubSeriesLinks}}<a href="{{.Link}}">Watch {{.Title}}</a>{{.Separator}}{{end}}</p>
                    <p><b>{{.VideoCount}} Videos</b> [{{.TotalDuration}}]</p>
                    <hr />
                    <p>{{.Dates}}</p>
                    <p>{{.Description}}</p>
                    </div>
                </div>
            </div>
        </li>
        {{end}}
    </ul>
  </div>
  <script src="script.js"></script>
</body>
</html>
