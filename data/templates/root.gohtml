<!DOCTYPE html>
<html>
<head>
    <title>{{if .AppName}}({{.AppName}}) {{end}}Just Some Gaming Diary</title>
    <link rel="stylesheet" type="text/css" href="style.css">
    <link rel="icon" type="image/png" href="{{.Logo}}">
</head>
<body style="background-image: url('{{.Background}}');">
  <div class="page-container">
    <h2 class="root series-title list-toggle">{{.VideoCount}} Videos ({{.TotalDuration}})</h2>
    <h3 class="root dates">{{.Dates}}</h3>
    <hr class="divider" />
    <a id="scroll-to-bottom" class="root scroll-button">Bottom</a>
    <ul>
        {{range .Series}}
        <li class="{{.Theme}}">
            <h1 class="entry-title list-toggle">Series {{.Index | printf "%02d"}} | {{.Title}}</h1>
            <div class="entry collapsable">
                <div class="grid-container">
                    <img src="{{.Thumbnail}}" width="100%"/>
                    <div class="entry-body">
                    <p class="card-header">{{range .SubSeriesLinks}}<a href="{{.Link}}">Watch {{.Title}}</a>{{.Separator}}{{end}}</p>
                    <p><b>{{.VideoCount}} Videos</b> [{{.TotalDuration}}]</p>
                    <hr />
                    <p>{{.Dates}}</p>
                    <p>{{.Description}}</p>
                    </div>
                </div>
            </div>
        </li>
        {{end}}
    </ul>
    <a id="scroll-to-top" class="root scroll-button">Top</a>
  </div>
  <script src="script.js"></script>
</body>
</html>
