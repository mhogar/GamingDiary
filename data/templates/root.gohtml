<!DOCTYPE html>
<html>
<head>
    <title>{{if .AppName}}({{.AppName}}) {{end}}Just Some Gaming Diary</title>
    <link rel="icon" type="image/png" href="{{.Icon}}">
    <link rel="stylesheet" type="text/css" href="style.css">
</head>
<body style="background-image: url('{{.Background}}');">
  <div class="page-container root ">
    <h2 class="series-title list-toggle">{{.VideoCount}} Videos ({{.TotalDuration}})</h2>
    <h3 class="dates">{{.Dates}}</h3>
    <a href="https://www.youtube.com/channel/UCnf7PefD6MoIegZqr9INKDA/" target="_blank">Youtube Channel</a>
    <hr class="divider" />
    <a id="scroll-to-bottom" class="scroll-button">Bottom</a>
    <ul>
        {{range .Series}}
        <li class="{{.Theme}}">
            <h1 class="entry-title list-toggle">Series {{.Index | printf "%02d"}} | {{.Title}}</h1>
            <div class="entry collapsable">
                <div class="grid-container">
                    <img src="{{.Thumbnail}}" width="100%"/>
                    <div class="entry-body">
                    <p class="card-header">{{range .SubSeriesLinks}}<a href="{{.Link}}">Watch {{.Title}}</a>{{.Separator}}{{end}}</p>
                    <p><b>{{.VideoCount}} Videos</b> [{{.TotalDuration}}]</p>
                    <hr />
                    <p>{{.Dates}}</p>
                    <p>{{.Description}}</p>
                    </div>
                </div>
            </div>
        </li>
        {{end}}
    </ul>
    <a id="scroll-to-top" class="scroll-button">Top</a>
  </div>
  <script src="script.js"></script>
</body>
</html>
