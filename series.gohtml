<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" type="text/css" href="../style.css">
    <link rel="stylesheet" type="text/css" href="groups.css">
</head>
<body class="{{.Theme}}" style="background-image: url('{{.Background}}');">
  <div class="page-container">
    <h1 class="series-title series-color">{{.Title}}</h1>
    <h3 class="dates">{{.Dates}}</h3>
    <div class="entry">
      <div class="grid-container">
        <img src="{{.Prologue.Thumbnail}}" width="100%"/>
        <div class="entry-body">
          <p>
            <a class="video-link" href="{{.Prologue.Video}}" target="_blank">Watch Prologue</a>
          </p>
          <p>{{.Prologue.Description}}</p>
        </div>
      </div>
    </div>
    <hr class="divider" />
    <ul>
      {{range .Videos}}
      <li>
        <h2 class="list-toggle entry-title{{range .Groups}} {{.}}{{end}}">{{.Title}}</h2>
        <div class="collapsable entry">
          <div class="grid-container">
            <img src="{{.Thumbnail}}" width="100%"/>
            <div class="entry-body">
              <p><a class="video-link" href="{{.Video}}" target="_blank">Play Video</a></p>
              <p>{{.Description}}</p>
            </div>
          </div>
        </div>
      </li>
      {{end}}
    </ul>
  </div>
  <script src="../base.js"></script>
</body>
</html>
